//@decl
struct Bz4 { s32 n; u8 pad[0xC]; f32 e[4][4]; };
//@func 0x21C468
extern "C" void func_0021C468(void) {
    Bz4 *p = (Bz4 *)D_33D720;
    s32 k = 0;
    do {
        s32 n = k + 1;
        p->n = n;
        s32 i = 0;
        f32 *q = &p->e[0][3];
        if (n >= 0) {
        loop:
            f32 t = (f32)i / (f32)n;
            f32 s = 1.0f - t;
            i++;
            q[-3] = s * s * s / 6.0f;
            q[-2] = (3.0f * t * t * t - 6.0f * t * t + 4.0f) / 6.0f;
            q[-1] = (-3.0f * t * t * t + 3.0f * t * t + 3.0f * t + 1.0f) / 6.0f;
            q[0] = t * t * t / 6.0f;
            q += 4;
            if (!(n < i)) goto loop;
        }
        k = n;
        p++;
    } while (k < 3);
}
