//@func 0x22FDB8
extern "C" s32 func_0022FDB8(FEnt *f, u32 *out, u32 max, s32 len) {
    DL *n = f->mB4.m4;
    DL *h = &f->mB4;
    u32 base = 0;
    u32 cnt = 0;
    if (n == h) return cnt;
    if (len <= 0) return cnt;
    do {
        u32 st = n->m8;
        u32 end = st + len;
        if (!(end < st + n->mC)) end = st + n->mC;
        CN *c = (CN *)f->mC4;
        if (c) {
            u32 *o = (u32 *)(cnt * 8 + (s32)out);
            for (; c; c = c->m0) {
                if (!c->m8) continue;
                if (c->m4 < st || !(c->m4 < end)) continue;
                if (cnt < max) { o[0] = base + (c->m4 - st); o[1] = *(u32 *)((u8 *)c + 0xC); }
                cnt++;
                o += 2;
            }
        }
        len -= n->mC;
        base += n->mC;
        n = n->m4;
    } while (n != h && len > 0);
    return cnt;
}
