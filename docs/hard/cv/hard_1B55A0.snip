//@func 0x1B55A0
extern "C" void func_001B55A0(void *self, s32 *x, s32 *y, s32 *w, s32 *h, s8 c) {
    *w = 10;
    *h = 20;
    if ((u8)c < 10) {
        *x = c * 11 + 1;
        *y = 0;
    } else if ((u32)(c - '0') < 10) {
        *x = (c - '0') * 11 + 1;
        *y = 0;
    } else if ((u8)(c - 'A') < 26) {
        s32 k = c - 'A';
        *x = k % 12 * 11 + 1;
        *y = k / 12 * 20 + 20;
    } else {
        switch (c) {
        case '!': *x = 0x17; *y = 0x3C; break;
        case '?': *x = 0x22; *y = 0x3C; break;
        case '(': *x = 0x2D; *y = 0x3C; break;
        case ')': *x = 0x38; *y = 0x3C; break;
        case '/': *x = 0x43; *y = 0x3C; break;
        case '-': *x = 0x4E; *y = 0x3C; break;
        case '.': *x = 0x59; *y = 0x3C; break;
        case ',': *x = 0x64; *y = 0x3C; break;
        case 'c':
            *x = 1; *y = 0x51; *w = 0x12; *h = 0x14;
            return;
        case 'k':
            *x = 0x14; *y = 0x51; *w = 0x12; *h = 0x14;
            return;
        case ' ': *x = 0x7A; *y = 0x3C; break;
        default:
            Func235DE0("*** no suppot char [%c]\n", c);
            *x = 0x7A;
            *y = 0x3C;
            return;
        }
    }
}
