//@func 0x2715B0
void func_002715B0(float m[4][4], float *n, float lx, float ly, float lz, int point)
{
    float a, b, c, d, r;
    float nx = n[0], ny = n[1], nz = n[2];
    if (point) {
        a = lx * nx;
        b = ly * ny;
        c = lz * nz;
        d = 1.0f - (a + b + c);
        m[0][3] = lx;
        m[1][3] = ly;
        m[2][3] = lz;
        m[3][0] = -nx;
        m[3][1] = -ny;
        m[3][2] = -nz;
        m[1][0] = ly * nx;
        m[0][1] = lx * ny;
        m[2][0] = lz * nx;
        m[2][1] = lz * ny;
        m[3][3] = d - 1.0f;
        m[0][0] = a + d;
        m[1][1] = b + d;
        m[2][2] = c + d;
        m[0][2] = lx * nz;
        m[1][2] = ly * nz;
    } else {
        a = lx * nx;
        b = ly * ny;
        c = lz * nz;
        d = a + b + c;
        r = -1.0f / d;
        m[0][3] = 0;
        m[1][3] = 0;
        m[2][3] = 0;
        m[3][3] = r * -d;
        m[0][0] = r * (a - d);
        m[1][0] = r * (ly * nx);
        m[2][0] = r * (lz * nx);
        m[3][0] = r * -nx;
        m[0][1] = r * (lx * ny);
        m[1][1] = r * (b - d);
        m[2][1] = r * (lz * ny);
        m[3][1] = r * -ny;
        m[0][2] = r * (lx * nz);
        m[1][2] = r * (ly * nz);
        m[2][2] = r * (c - d);
        m[3][2] = r * -nz;
    }
}
