    unsigned long long m = *(unsigned long long *)&d;
    e = (long long)((m << 1) >> 53) - 0x433;
    if (e < -0x35) return 0;
    if (e >= 13) return 9999;
    m = ((m << 12) >> 12) | (1ULL << 52);
    if (e < 0) {
        e = -e;
        m >>= e - 2;
        if ((m & 3) == 3) m = (m >> 2) + 1;
        else m >>= 2;
    } else
