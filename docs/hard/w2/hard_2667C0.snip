//@decl
//@func 0x2667C0
extern "C" s32 func_002667C0(s32 *idx, s32 *val, u64 code)
{
    Reg64 *e = D_002BD7A8;
    s32 i, found = 0;
    u64 m;
    s32 n;
    for (i = 0; i < 10 && !found; i++, e++) {
        switch (e->m8) {
        case 0xFFFFFFFFFFULL:
            if ((code & 0xFFFFFF0000ULL) == e->m0) {
                *idx = i;
                *val = (s32)(code & 0xFFFF);
                found = 1;
            }
            break;
        case 0xFFFF000000ULL:
            switch (e->m0) {
            case 0xBD20000000ULL: m = 0xFFE0000000ULL; n = 0x1F; break;
            case 0xBD80000000ULL:
            case 0xBD88000000ULL:
            case 0xBD90000000ULL:
            case 0xBDA0000000ULL: m = 0xFFF8000000ULL; n = 7; break;
            default: m = 0xFFFF000000ULL; n = 0; break;
            }
            if ((code & m) == e->m0) {
                *idx = i;
                *val = (code >> 24) & n;
                found = 1;
            }
            break;
        case 0xFF00000000ULL:
            switch (e->m0) {
            case 0xE000000000ULL: m = 0xF000000000ULL; n = 0xF; break;
            case 0xC000000000ULL: m = 0xE000000000ULL; n = 0x1F; break;
            default: m = 0xFF00000000ULL; n = 0; break;
            }
            if ((code & m) == e->m0) {
                *idx = i;
                *val = (code >> 32) & n;
                found = 1;
            }
            break;
        }
    }
    return found;
}
