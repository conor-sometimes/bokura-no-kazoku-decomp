//@decl
struct W2FontCh2 { u8 p0[0xA]; s8 mA; u8 pB[5]; s8 m10; };
struct W2FontLay2 { u8 p0[0x10]; f32 m10; f32 m14; u8 p18[8]; f32 m20; u8 p24[0x2C]; f32 m50; u8 p54[0x28]; s32 m7C; };
extern "C" void func_00256DC8(void *ctx, W2FontCh2 *c, W2FontLay2 *l, f32 x, f32 y);
//@func 0x257068
extern "C" void func_00257068(void *ctx, f32 *ow, f32 *oh, W2FontCh2 **items, s32 n, W2FontLay2 *l, s32 flags, f32 x, f32 y)
{
    f32 w = 0.0f;
    s32 i;
    for (i = 0; i < n; i++) {
        f32 adv;
        if (items[i] != 0) {
            if (l->m7C) {
                if (flags & 4) func_00256DC8(ctx, items[i], l, x + w + (f32)items[i]->m10 * l->m20, y);
                adv = l->m10;
            } else {
                if (flags & 4) func_00256DC8(ctx, items[i], l, x + w, y);
                adv = (f32)items[i]->mA * l->m20;
            }
        } else {
            adv = l->m10;
        }
        w += adv;
        w += l->m50;
    }
    w -= l->m50;
    *ow = w;
    *oh = l->m14;
}
