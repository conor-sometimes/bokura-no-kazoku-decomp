//@decl
extern W2Fp D_002EAB80;
static inline W2Fp *w2_fpdiv_parts(W2Fp *a, W2Fp *b)
{
    u64 bit;
    u64 numerator;
    u64 denominator;
    u64 quotient;

    if (w2_isnan(a)) {
        return a;
    }
    if (w2_isnan(b)) {
        return b;
    }

    a->sign = a->sign ^ b->sign;

    if (w2_isinf(a) || w2_iszero(a)) {
        if (a->cls == b->cls)
            return &D_002EAB80;
        return a;
    }

    if (w2_isinf(b)) {
        a->frac = 0;
        a->exp = 0;
        return a;
    }
    if (w2_iszero(b)) {
        a->cls = W2_INF;
        return a;
    }

    {
        a->exp = a->exp - b->exp;
        numerator = a->frac;
        denominator = b->frac;

        if (numerator < denominator) {
            numerator *= 2;
            a->exp -= 1;
        }
        bit = 1ULL << 60;
        quotient = 0;
        while (bit) {
            if (numerator >= denominator) {
                quotient |= bit;
                numerator -= denominator;
            }
            bit >>= 1;
            numerator *= 2;
        }

        a->frac = quotient;
        return (a);
    }
}
//@func 0x285180
extern "C" double dpdiv(double arg_a, double arg_b)
{
    W2Fp a;
    W2Fp b;
    W2Fp *res;
    union { double d; u64 l; } au, bu;

    au.d = arg_a;
    bu.d = arg_b;

    func_002881A8(&au, (W2FpNum2 *)&a);
    func_002881A8(&bu, (W2FpNum2 *)&b);

    res = w2_fpdiv_parts(&a, &b);

    return func_002880D0((W2FpNum *)res);
}
