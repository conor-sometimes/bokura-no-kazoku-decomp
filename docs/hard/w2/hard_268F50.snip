                sel = W2I(d, 0x138) ? 1 : 0;
                func_0026AD28((u8 *)d, DMV, dmvector, PMV[0][0][0], PMV[0][0][1]);
                func_00269658(d, pred[0][currentfield], 0, 0, 0, 16, bx, by, PMV[0][0][0], PMV[0][0][1], 0, 0);
                func_00269658(d, pred[sel][!currentfield], 0, 0, 0, 16, bx, by, DMV[0][0], DMV[0][1], 0, 1);
            } else {
                ((s32 (*)(MpegSys *, const char *, ...))func_00268368)(d, D_002E9718, mtype);
