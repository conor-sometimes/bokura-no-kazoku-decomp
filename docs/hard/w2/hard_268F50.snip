#define W2I(d, off) (*(s32 *)((u8 *)(d) + (off)))
//@func 0x268F50
/* mpeg2decode recon.c form_predictions, Sony IPU variant */
extern "C" void func_00268F50(MpegSys *d, s32 bx, s32 by, s32 mbtype, s32 mtype, s32 vPMV, s32 vmvfs, s32 vdmv)
{
    s32 (*PMV)[2][2] = (s32 (*)[2][2])vPMV;
    s32 (*mvfs)[2] = (s32 (*)[2])vmvfs;
    s32 *dmvector = (s32 *)vdmv;
    s32 DMV[2][2];
    s32 pred[2][2];
    s32 currentfield, sel;
    s32 avg = 0;
