    if ((mbtype & 8) || W2I(d, 0x168) == 2) {
        if (d->m18C == 3) {
            if (mtype == 2 || !(mbtype & 8)) {
                func_00269658(d, W2I(d, 0x1D0), 0, 0, 0, 16, bx, by, PMV[0][0][0], PMV[0][0][1], 0, 0);
