        } else if (mtype == 2) {
            func_00269658(d, mvfs[0][1] ? W2I(d, 0x1F4) : W2I(d, 0x1E4), 0, 0, 0, 8, bx, by, PMV[0][1][0], PMV[0][1][1], 0, avg);
            func_00269658(d, mvfs[1][1] ? W2I(d, 0x1F4) : W2I(d, 0x1E4), 0, 0, 8, 8, bx, by, PMV[1][1][0], PMV[1][1][1], 0, avg);
        } else {
            ((s32 (*)(MpegSys *, const char *, ...))func_00268368)(d, D_002E9738, mtype);
        }
    }
