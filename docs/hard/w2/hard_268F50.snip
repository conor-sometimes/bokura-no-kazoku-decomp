                func_00269658(d, W2I(d, 0x1D0), 0, 0, 0, 8, bx, by, PMV[0][0][0], PMV[0][0][1] >> 1, 1, 0);
                func_00269658(d, W2I(d, 0x1D0), 1, 0, 0, 8, bx, by, DMV[0][0], DMV[0][1], 1, 1);
                func_00269658(d, W2I(d, 0x1D0), 1, 1, 0, 8, bx, by, PMV[0][0][0], PMV[0][0][1] >> 1, 1, 0);
                func_00269658(d, W2I(d, 0x1D0), 0, 1, 0, 8, bx, by, DMV[1][0], DMV[1][1], 1, 1);
            } else {
                ((s32 (*)(MpegSys *, const char *, ...))func_00268368)(d, D_002E96F8, mtype);
