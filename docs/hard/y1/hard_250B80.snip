//@decl
inline CRU *Y1RIt(CRU *n) { return n->m_isHead ? 0 : n; }
//@func 0x250B80
extern "C" CRU *func_00250B80(CResCache *c, s32 idx)
{
    CRU *n;
    s32 k, i = 0;
    for (k = 0; k < 2; k++)
        for (n = Y1RIt((k ? &c->m_used : &c->m_free)->next); n; n = Y1RIt(n->m_next)) {
            if (idx == i) return n;
            i++;
        }
    return 0;
}
