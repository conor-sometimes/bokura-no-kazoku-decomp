    }
fail:
    if (D_38F188.m_flags & 2)
        Func235DE0("*** memheap : can't allocate size (%d)\n", size);
    return 0;
found:
    if (asize + 16 < b->m_size) {
        n = func_002466E8(mode, n, asize);
        if (!n) return 0;
        b = n->m_blk;
    }
    b->m_req = size;
    b->m_tag = h->m_tag;
    h->m_used += b->m_size;
    h->m_count += size;
    D_38F188.m_slot[func_001F1180()].m_used += asize;
    func_00246858(h);
