        b = n->m_blk;
        asize = (s32)(b->m_size * D_38F188.m_ratio[func_001F1180()]) & ~15;
        mode = 0;
        size = asize;
        goto found;
    }
    asize = (size + 15) & ~15;
    switch (mode) {
    case 0:
        for (n = first; n != &h->m_list; n = n->m_next) {
            b = n->m_blk;
            if (b->m_req <= 0 && b->m_size >= asize)
                goto found;
            if (n == last) break;
        }
