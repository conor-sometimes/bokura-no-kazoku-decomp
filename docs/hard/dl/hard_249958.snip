//@decl
#define DL_REFILL() if (!mask) { flags = *src++; mask = 0x80; }
//@func 0x249958
extern "C" s32 DlLzDecode(char *dst, const char *src) asm("func_00249958");
extern "C" s32 DlLzDecode(char *dst, const char *src)
{
    s32 flags = *src++;
    s32 mask = 0x80;
    s32 off, len, k, r;
    const char *p;
    for (;;) {
        DL_REFILL();
        if (flags & mask) {
            mask >>= 1;
        } else {
            mask >>= 1;
            *dst++ = *src++;
            continue;
        }
        DL_REFILL();
        if (flags & mask) {
            off = *src++ | -0x100;
            mask >>= 1;
            DL_REFILL(); off = (flags & mask) ? off * 2 + 1 : off * 2; mask >>= 1;
            DL_REFILL(); off = (flags & mask) ? off * 2 + 1 : off * 2; mask >>= 1;
            DL_REFILL(); off = (flags & mask) ? off * 2 + 1 : off * 2; mask >>= 1;
            DL_REFILL(); off = (flags & mask) ? off * 2 + 1 : off * 2; mask >>= 1;
            off -= 0xFF;
        } else {
            off = *src++;
            mask >>= 1;
            if (off == 0) return 1;
            off |= -0x100;
        }
        len = 1;
        for (;;) {
            DL_REFILL();
            if (!(flags & mask)) break;
            mask >>= 1;
            DL_REFILL();
            len = (flags & mask) ? len * 2 + 1 : len * 2;
            mask >>= 1;
        }
        mask >>= 1;
        if (len < 7) {
            while (len-- >= 0) { *dst = dst[off]; dst++; }
        } else {
            len++;
            k = len >> 3;
            r = len & 7;
            dst = dst + r - 8;
            p = dst + off;
            switch (r) {
            default: do { dst[0] = p[0];
            case 7: dst[1] = p[1];
            case 6: dst[2] = p[2];
            case 5: dst[3] = p[3];
            case 4: dst[4] = p[4];
            case 3: dst[5] = p[5];
            case 2: dst[6] = p[6];
            case 1: dst[7] = p[7];
            case 0: k--; dst += 8; p += 8; } while (k >= 0);
            }
        }
    }
}
