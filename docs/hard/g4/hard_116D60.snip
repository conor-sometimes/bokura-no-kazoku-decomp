inline f32 WrapDelta(f32 d) {
    f32 w;
    if (-0.5f <= d && d < 0.5f) {
        w = d;
    } else if (0.0f < d) {
        w = d + -1.0f;
    } else {
        w = d + 1.0f;
    }
    return w;
}
