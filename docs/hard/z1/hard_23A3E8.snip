//@func 0x23A3E8

static inline void LInit(LNode *h, s32 first) { h->b = first; h->a = -1; }
static inline void LTail(LNode *h, s32 last) { h->a = last; h->b = -1; }
extern "C" void func_0023A3E8(LNode *t, s32 n)
{
    s32 i;
    LNode *q;
    LInit(&t[0], 1);
    LTail(&t[1], 0);
    for (i = 0; i < 2; i++) {
        LInit(&t[2 + i], i + 4);
        LTail(&t[4 + i], i + 2);
    }
    LInit(&t[6], 7);
    LTail(&t[7], 6);
    for (i = 8, q = &t[8]; i < n; i++, q++) {
        LNode *h7 = &t[7];
        s32 pr = h7->a;
        t[pr].b = i;
        q->a = pr;
        q->b = 7;
        h7->a = i;
    }
}
