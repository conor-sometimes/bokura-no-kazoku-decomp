//@decl
// decl in the unit: change func_0022B138 to return s32

//@func 0x22B138
extern "C" s32 func_0022B138(Heap *hp) {
    HeapX *h = (HeapX *)hp;
    s32 ret = 0;
    u32 i;
    Nd *n;
    Bk *b;
    Bk *prev;
    Bk *end;
    for (i = 0, n = (Nd *)(((u32)h + 0x4F) & ~0xF); i < (u32)h->mC; i++, n++) {
        if (n->m4 && ((Nd *)n->m4)->m8 != n) {
            func_0022B5C8("INVALID: master prev %08X->%08X->%08X\n", n, n->m4, ((Nd *)n->m4)->m8);
            ret = -1;
        }
        if (n->m8 && (Nd *)n->m8->m4 != n) {
            func_0022B5C8("INVALID: master next %08X->%08X->%08X\n", n, n->m8, n->m8->m4);
            ret = -1;
        }
    }
    for (n = (Nd *)h->m4; n; n = n->m8) {
        Bk *bb = (Bk *)((u8 *)n->m0 - 0x10);
        if (bb->m0 != n) {
            func_0022B5C8("INVALID: master:%08X->%08X block:%08X->%08X\n", n, bb, bb, bb->m0);
            ret = -1;
        }
    }
    prev = 0;
    end = (Bk *)(h->m28 + h->m2C);
    for (i = 0, b = (Bk *)h->m28; b < end; prev = b, b = (Bk *)((u8 *)b + b->m8), i++) {
        if (!prev) {
            if (b->m4) {
                func_0022B5C8("INVALID: heapblock[%d:%08X] prev size %d != 0\n", i, b, b->m4);
                ret = -1;
            }
        } else if (prev->m8 != b->m4) {
            func_0022B5C8("INVALID: heapblock[%d:%08X] prev size %d != heapblock[%d:%08X] size %d\n", i, b, b->m4, i - 1, prev, prev->m8);
            ret = -1;
        }
        n = b->m0;
        if (b->mC & 0x10000000) {
            if (!n->m4 && !n->m8 && h->m14 != 1) {
                func_0022B5C8("INVALID: heapblock[%d:%08X:%08X] free but unlinked\n", i, b, n);
                ret = -1;
            }
        } else if (n->m4 || n->m8) {
            func_0022B5C8("INVALID: heapblock[%d:%08X:%08X] used but linked prev->%08X next->%08X\n", i, b, n, n->m4, n->m8);
            ret = -1;
        }
    }
    return ret;
}
