//@func 0x2299E0
// needs the unit decl `func_002299E0(u8 *d, u8 *s, u32 n)` and its caller in Unit228F78 casting the arguments (DIFF 15: r and n swap $6/$7, d/s end-pointer adds in the other order)

extern "C" void func_002299E0(u8 *d, u8 *s, u32 n)
{
    u32 q, r = n;
    if (((u32)s & 7) == 0 && ((u32)d & 7) == 0) {
        q = n >> 3;
        r = n & 7;
    } else {
        q = 0;
    }
    if (d < s) {
        while (q--) { *(u64 *)d = *(u64 *)s; s += 8; d += 8; }
        while (r--) *d++ = *s++;
    } else {
        d += n;
        s += n;
        while (r--) *--d = *--s;
        while (q--) { s -= 8; d -= 8; *(u64 *)d = *(u64 *)s; }
    }
}
