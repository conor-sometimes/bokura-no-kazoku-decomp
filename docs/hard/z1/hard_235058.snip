//@func 0x235058

extern "C" const char *func_00235058(char *dst, const char *src)
{
    char *d = dst;
    s32 n = 0;
    *d = 0;
    goto test;
next:
    d++;
    *d = 0;
    src++;
    n++;
test:
    if (*src == 0) return src;
    if (IsEol(*src)) return src;
    if (*src != '=') {
        *d = *src;
        goto next;
    }
    while (n > 0 && IsBlank(dst[n - 1])) n--;
    dst[n] = 0;
    return src;
}
